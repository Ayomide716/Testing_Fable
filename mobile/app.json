{
  "expo": {
    "name": "ClipSync",
    "slug": "clipsync",
    "owner": "ayfrosh2008",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "clipsync",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05060B",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#05060B",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clipsync.app",
      "infoPlist": {
        "NSCameraUsageDescription": "ClipSync uses the camera once, to read the pairing code shown on your computer.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.clipsync.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05060B"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "ClipSync uses the camera once, to read the pairing code shown on your computer."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "ClipSync protects your clipboard key with device authentication."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#22D3EE",
          "defaultChannel": "clipboard-sync",
          "icon": "./assets/notification-icon.png"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "919aaa24-94af-4d3b-b53e-c669891de10f"
      }
    },
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
